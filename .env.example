# Placeholders only. All variables are server-side unless explicitly NEXT_PUBLIC_.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
# Invitation links use this origin plus /auth/invite.
# Staging and production must set an https origin that is not localhost.
# Do not use a one-off Vercel deployment hash. See docs/runbooks/CAN-07-STAFF-INVITATION.md.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_OR_STAGING_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
WOO_BASE_URL=https://staging-shop.example.invalid
WOO_CONSUMER_KEY=REPLACE_WITH_SERVER_ONLY_KEY
WOO_CONSUMER_SECRET=REPLACE_WITH_SERVER_ONLY_SECRET
BRIDGE_BASE_URL=https://staging-shop.example.invalid/wp-json/cetech-pos/v1
BRIDGE_USERNAME=REPLACE_WITH_DEDICATED_SERVICE_USER
BRIDGE_APPLICATION_PASSWORD=REPLACE_WITH_SERVER_ONLY_PASSWORD
PAYMENT_PROVIDER=disabled
PAYSTACK_MODE=test
# Electronic methods are server-owned capabilities. Enable only methods verified for this environment.
PAYSTACK_MOBILE_MONEY_ENABLED=false
PAYSTACK_CARD_ENABLED=false
PAYSTACK_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SANDBOX_KEY
PAYSTACK_TEST_PAYER_EMAIL=REPLACE_WITH_SERVER_ONLY_SANDBOX_PAYER
PAYMENT_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SANDBOX_KEY
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PROVIDER_SPECIFIC_SECRET_IF_REQUIRED
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Webhook verification depends on provider; do not assume this variable alone implements it.
